rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sensitivePlayerKeys() {
      return ["email", "birthYear", "lat", "lng", "geohash"];
    }

    function playerWriteHasNoSensitiveFields() {
      return !request.resource.data.keys().hasAny(sensitivePlayerKeys());
    }

    function editablePlayerProfileKeys() {
      return [
        "name",
        "nameLower",
        "postcode",
        "bio",
        "availability",
        "gender",
        "isMatchable",
        "skillBand",
        "skillBandLabel",
        "skillRating",
        "utr",
        "skillLevel",
        "photoURL",
        "photoThumbURL",
        "avatar",
        "clubId",
        "clubName",
        "clubStatus",
        "profileComplete"
      ];
    }

    function playerClientMutableKeys() {
      return editablePlayerProfileKeys().concat([
        "badges",
        "googlePhotoURL",
        "timestamp",
        "updatedAt"
      ]);
    }

    function playerCreateAllowedKeys() {
      return playerClientMutableKeys().concat(["createdAt"]);
    }

    function trustedAccountLifecycleKeys() {
      return [
        "accountInitialization",
        "accountStatus",
        "waitlistPostcode",
        "verificationInitialSendClaimedAt",
        "referralAttribution"
      ];
    }

    function onboardingCreateValid() {
      let onboarding = request.resource.data.get("onboarding", {});
      return onboarding is map
        && !onboarding.keys().hasAny([
          "v2StartedAt",
          "version",
          "completedAt",
          "matchIntro",
          "homeWelcome"
        ]);
    }

    function matchIntroTransitionValid(before, after) {
      let oldIntro = before.get("matchIntro", {});
      let newIntro = after.get("matchIntro", {});
      let oldStatus = oldIntro.get("status", "");
      let newStatus = newIntro.get("status", "");
      return newIntro == oldIntro
        || (before.get("v2StartedAt", null) is timestamp
          && before.get("version", 0) == 2
          && before.get("completedAt", null) is timestamp
          && oldIntro is map
          && newIntro is map
          && newIntro.keys().hasOnly(["status", "updatedAt"])
          && newIntro.get("updatedAt", null) == request.time
          && ((oldStatus == "not_started"
              && (newStatus == "completed" || newStatus == "skipped"))
            || ((oldStatus == "completed" || oldStatus == "skipped")
              && newStatus == oldStatus)));
    }

    function homeWelcomeTransitionValid(before, after) {
      let oldWelcome = before.get("homeWelcome", {});
      let newWelcome = after.get("homeWelcome", {});
      let oldStatus = oldWelcome.get("status", "");
      let newStatus = newWelcome.get("status", "");
      return newWelcome == oldWelcome
        || (before.get("v2StartedAt", null) is timestamp
          && before.get("version", 0) == 2
          && before.get("completedAt", null) is timestamp
          && oldWelcome is map
          && newWelcome is map
          && newWelcome.keys().hasOnly(["status", "updatedAt"])
          && newWelcome.get("updatedAt", null) == request.time
          && ((oldStatus == "not_seen"
              && (newStatus == "dismissed" || newStatus == "used_find_players"))
            || ((oldStatus == "dismissed" || oldStatus == "used_find_players")
              && newStatus == oldStatus)));
    }

    function onboardingUpdateValid() {
      let userChanged = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get("onboarding", {});
      let after = request.resource.data.get("onboarding", {});
      let onboardingChanged = after.diff(before).affectedKeys();
      let guidanceChanged = onboardingChanged.hasAny(["matchIntro", "homeWelcome"]);
      return !userChanged.hasAny(["onboarding"])
        || (before is map
          && after is map
          && !onboardingChanged.hasAny(["v2StartedAt", "version", "completedAt"])
          && (!guidanceChanged
            || (onboardingChanged.hasOnly(["matchIntro", "homeWelcome"])
              && matchIntroTransitionValid(before, after)
              && homeWelcomeTransitionValid(before, after))));
    }

    function clubMembershipValid(data) {
      let status = data.get("clubStatus", null);
      let clubId = data.get("clubId", null);
      let clubName = data.get("clubName", null);
      return (status == null && clubId == null && clubName == null)
        || (status == "none" && clubId == null && clubName == null)
        || (status == "member"
          && clubId is string
          && clubName is string
          && clubName.size() > 0
          && exists(/databases/$(database)/documents/courts/$(clubId))
          && get(/databases/$(database)/documents/courts/$(clubId)).data.name == clubName);
    }

    function participantsOf(data) {
      return data.participants is list ? data.participants : [];
    }

    function playersOf(data) {
      return data.players is list ? data.players : [];
    }

    function relationshipParticipant(data) {
      return signedIn()
        && data.players is list
        && request.auth.uid in data.players;
    }

    function relationshipPlayersValid(data) {
      return data.players is list
        && data.players.size() == 2
        && data.playerAId is string
        && data.playerBId is string
        && data.playerAId in data.players
        && data.playerBId in data.players
        && data.playerAId != data.playerBId;
    }

    function relationshipAllowedKeys() {
      return [
        "pairId",
        "players",
        "playerAId",
        "playerBId",
        "status",
        "createdAt",
        "updatedAt",
        "lastInteractionAt",
        "lastInteraction",
        "refs",
        "relationshipRefPath",
        "playerSnapshots",
        "chatHiddenFor",
        "matchConnectionHiddenFor",
        "matchConnectionDeletedFor"
      ];
    }

    function relationshipIdentityUnchanged() {
      return request.resource.data.pairId == resource.data.pairId
        && request.resource.data.players == resource.data.players
        && request.resource.data.playerAId == resource.data.playerAId
        && request.resource.data.playerBId == resource.data.playerBId;
    }

    function relationshipOtherPlayerId() {
      return resource.data.playerAId == request.auth.uid
        ? resource.data.playerBId
        : resource.data.playerAId;
    }

    function relationshipVisibilityMapSafe(fieldName) {
      return request.resource.data.get(fieldName, {}).keys().hasOnly(resource.data.players)
        && request.resource.data.get(fieldName, {}).get(relationshipOtherPlayerId(), null)
          == resource.data.get(fieldName, {}).get(relationshipOtherPlayerId(), null);
    }

    function relationshipVisibilityFieldsSafe() {
      return relationshipVisibilityMapSafe("chatHiddenFor")
        && relationshipVisibilityMapSafe("matchConnectionHiddenFor")
        && relationshipVisibilityMapSafe("matchConnectionDeletedFor");
    }

    function isConversationParticipant() {
      return signedIn()
        && request.auth.uid in participantsOf(resource.data);
    }

    function isConversationParticipantOnCreate() {
      return signedIn()
        && request.auth.uid in participantsOf(request.resource.data);
    }

    function conversationParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function identityFieldsUnchanged() {
      return (!("participants" in resource.data) || request.resource.data.participants == resource.data.participants)
        && (!("players" in resource.data) || request.resource.data.players == resource.data.players)
        && (!("fromUserId" in resource.data) || request.resource.data.fromUserId == resource.data.fromUserId)
        && (!("toUserId" in resource.data) || request.resource.data.toUserId == resource.data.toUserId)
        && (!("senderId" in resource.data) || request.resource.data.senderId == resource.data.senderId)
        && (!("receiverId" in resource.data) || request.resource.data.receiverId == resource.data.receiverId)
        && (!("userId" in resource.data) || request.resource.data.userId == resource.data.userId)
        && (!("ownerId" in resource.data) || request.resource.data.ownerId == resource.data.ownerId)
        && (!("pairId" in resource.data) || request.resource.data.pairId == resource.data.pairId)
        && (!("relationshipRefPath" in resource.data) || request.resource.data.relationshipRefPath == resource.data.relationshipRefPath);
    }

    function isMatchPartyFromResource() {
      return signedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in playersOf(resource.data) ||
        request.auth.uid in participantsOf(resource.data)
      );
    }

    function isMatchPartyFromRequest() {
      return signedIn() && (
        request.resource.data.fromUserId == request.auth.uid ||
        request.resource.data.toUserId == request.auth.uid ||
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.receiverId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.auth.uid in playersOf(request.resource.data) ||
        request.auth.uid in participantsOf(request.resource.data)
      );
    }

    function isNotificationRecipient() {
      return signedIn() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    function isNotificationCreateAllowed() {
      return signedIn()
        && (
          request.resource.data.fromUserId == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid
        )
        && (
          request.resource.data.recipientId is string ||
          request.resource.data.toUserId is string ||
          request.resource.data.userId is string
        );
    }

    function isEventHostFromResource() {
      return signedIn() && (
        resource.data.get("hostId", "") == request.auth.uid ||
        resource.data.get("createdBy", "") == request.auth.uid ||
        resource.data.get("ownerId", "") == request.auth.uid
      );
    }

    function isSupportedEventDuration(value) {
      return value is int && value in [30, 60, 90, 120];
    }

    function validEventDurationOnCreate() {
      return isSupportedEventDuration(request.resource.data.get("durationMinutes", null))
        && (
          !request.resource.data.keys().hasAny(["durationMins"]) ||
          request.resource.data.durationMins == request.resource.data.durationMinutes
        );
    }

    function validEventDurationOnUpdate() {
      return (
          request.resource.data.get("durationMinutes", null) ==
            resource.data.get("durationMinutes", null) &&
          request.resource.data.get("durationMins", null) ==
            resource.data.get("durationMins", null)
        ) || (
          isSupportedEventDuration(request.resource.data.get("durationMinutes", null)) &&
          (
            !request.resource.data.keys().hasAny(["durationMins"]) ||
            request.resource.data.durationMins == request.resource.data.durationMinutes
          )
        );
    }

    function eventHost(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return signedIn() && (
        event.get("hostId", "") == request.auth.uid ||
        event.get("createdBy", "") == request.auth.uid ||
        event.get("ownerId", "") == request.auth.uid
      );
    }

    function eventParticipant(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return signedIn() && (
        event.get("hostId", "") == request.auth.uid ||
        event.get("createdBy", "") == request.auth.uid ||
        event.get("ownerId", "") == request.auth.uid ||
        request.auth.uid in participantsOf(event)
      );
    }

    function hasEventConversationContext(data) {
      let context = data.get("context", {});
      return context.get("type", "") == "event";
    }

    function isEventConversation(data, conversationId) {
      let context = data.get("context", {});
      return hasEventConversationContext(data)
        && context.get("eventId", "") is string
        && conversationId == "event_" + context.get("eventId", "");
    }

    function eventConversationParticipantsMatch(data) {
      let eventId = data.get("context", {}).get("eventId", "");
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      let expectedParticipants = participantsOf(event).concat([event.hostId]);
      return data.participants is list
        && event.hostId is string
        && data.participants.size() == data.participants.toSet().size()
        && data.participants.toSet() == expectedParticipants.toSet();
    }

    function canAccessConversation(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return signedIn() && (
        (isEventConversation(conversation, conversationId)
          && eventParticipant(conversation.context.eventId))
        || (!hasEventConversationContext(conversation)
          && request.auth.uid in participantsOf(conversation))
      );
    }

    match /mail/{docId} {
      allow create: if signedIn()
        && request.auth.token.email == "william.ray.bourke@gmail.com";
      allow read, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && !request.resource.data.keys().hasAny(trustedAccountLifecycleKeys())
        && onboardingCreateValid();
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(trustedAccountLifecycleKeys())
        && onboardingUpdateValid();
      allow delete: if isSelf(uid);

      match /devices/{token} {
        allow read, write: if isSelf(uid);
      }

      match /dismissedPlayers/{dismissedPlayerId} {
        allow read, create, update, delete: if isSelf(uid)
          && dismissedPlayerId != uid;
      }

      match /match_recommendation_impressions/{candidateId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && candidateId != uid
          && request.resource.data.candidateId == candidateId
          && request.resource.data.keys().hasOnly([
            "candidateId",
            "firstSeenAt",
            "lastSeenAt",
            "timesShown",
            "lastBaseScore",
            "lastFinalScore"
          ]);
        allow delete: if false;
      }
    }

    match /players/{uid} {
      allow read: if signedIn();

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActiveAt"]);

      allow create: if isSelf(uid)
        && playerWriteHasNoSensitiveFields()
        && clubMembershipValid(request.resource.data)
        && request.resource.data.keys().hasOnly(playerCreateAllowedKeys());

      allow update: if isSelf(uid)
        && clubMembershipValid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(playerClientMutableKeys());

      allow delete: if false;
    }

    match /players_private/{uid} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid)
        && request.resource.data.email == request.auth.token.email;
    }

    match /waitlist_users/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;
    }

    match /player_public_stats/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /clubRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "clubName",
          "suburb",
          "submittedBy",
          "submittedAt",
          "status"
        ])
        && request.resource.data.clubName is string
        && request.resource.data.clubName.size() > 0
        && request.resource.data.clubName.size() <= 100
        && request.resource.data.suburb is string
        && request.resource.data.suburb.size() > 0
        && request.resource.data.suburb.size() <= 80
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedAt == request.time
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    // Server-generated Activity Leaderboard data. Only the current published
    // ranking generation has a signed-in client read contract.
    match /activity_match_events/{eventId} {
      allow read, write: if false;
    }

    match /activity_recalculation_requests/{monthKey} {
      allow read, write: if false;
    }

    match /activity_duplicate_reviews/{duplicateGroupKey} {
      allow read, write: if false;
    }

    match /activity_duplicate_resolutions/{duplicateGroupKey} {
      allow read, write: if false;
    }

    match /activity_backfill_runs/{runId} {
      allow read, write: if false;
    }

    match /activity_phase2_runs/{runId} {
      allow read, write: if false;
    }

    match /activity_months/{monthKey} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /activity_leaderboards/{leaderboardId} {
      allow read: if signedIn()
        && resource.data.status == "published";
      allow write: if false;

      match /generations/{generationId} {
        allow read: if signedIn()
          && generationId == get(/databases/$(database)/documents/activity_leaderboards/$(leaderboardId)).data.publishedGenerationId
          && resource.data.status == "published";
        allow write: if false;

        match /rankings/{playerId} {
          allow read: if signedIn()
            && generationId == get(/databases/$(database)/documents/activity_leaderboards/$(leaderboardId)).data.publishedGenerationId;
          allow write: if false;
        }

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Stage 1-3 player_relationships parent/link records.
    // New match_requests, match_invites, and completed match lifecycle docs write these; stats/counters are reserved
    // for a later Cloud Functions-backed migration.
    match /player_relationships/{pairId} {
      allow read: if relationshipParticipant(resource.data);

      allow create: if signedIn()
        && pairId == request.resource.data.pairId
        && relationshipPlayersValid(request.resource.data)
        && request.auth.uid in request.resource.data.players
        && request.resource.data.keys().hasOnly(relationshipAllowedKeys());

      allow update: if relationshipParticipant(resource.data)
        && relationshipPlayersValid(request.resource.data)
        && relationshipIdentityUnchanged()
        && relationshipVisibilityFieldsSafe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(relationshipAllowedKeys());

      allow delete: if false;
    }

    match /coaches/{coachId} {
      allow read: if signedIn();

      allow create, update: if isSelf(coachId)
        && request.resource.data.userId == request.auth.uid;

      allow delete: if false;

      match /viewers/{uid} {
        allow read: if isSelf(coachId);
        allow create, update: if isSelf(uid);
        allow delete: if false;
      }

      match /uniqueClicks/{docId} {
        allow read: if isSelf(coachId);
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /postcodes/{postcode} {
      allow read: if true;
      allow write: if false;
    }

    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }

    match /booking/{bookingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /device_tokens/{id} {
      allow write: if signedIn();
      allow read, delete: if false;
    }

    match /calendar_events/{docId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

match /conversations/{conversationId} {
  // The messages index uses an array-contains collection query. Keep parent
  // conversation reads query-compatible; message content remains restricted
  // by the nested rules below.
  allow read: if signedIn();

  allow create: if (
      isEventConversation(request.resource.data, conversationId)
      && eventParticipant(request.resource.data.context.eventId)
      && eventConversationParticipantsMatch(request.resource.data)
    ) || (
      !hasEventConversationContext(request.resource.data)
      && isConversationParticipantOnCreate()
      && request.resource.data.participants is list
      && request.resource.data.participants.size() >= 2
    );

  allow update: if (
      isEventConversation(resource.data, conversationId)
      && isEventConversation(request.resource.data, conversationId)
      && request.resource.data.context.eventId == resource.data.context.eventId
      && eventParticipant(resource.data.context.eventId)
      && eventConversationParticipantsMatch(request.resource.data)
    ) || (
      !hasEventConversationContext(resource.data)
      && isConversationParticipant()
      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["participants"])
    );

  allow delete: if false;
  
match /messages/{messageId} {
  allow read: if canAccessConversation(conversationId);

  allow create: if canAccessConversation(conversationId)
    && (
      request.resource.data.senderId == request.auth.uid ||
      request.resource.data.fromUserId == request.auth.uid ||
      request.resource.data.userId == request.auth.uid
    );

  allow update: if canAccessConversation(conversationId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "read",
      "readAt",
      "inviteStatus",
      "inviteBookingStatus",
      "inviteBookedBy",
      "inviteBookedAt",
      "updatedAt"
    ]);

  allow delete: if false;
}
}

match /match_requests/{matchId} {
  allow read: if signedIn()
    && (
      resource.data.fromUserId == request.auth.uid ||
      resource.data.toUserId == request.auth.uid ||
      resource.data.senderId == request.auth.uid ||
      resource.data.receiverId == request.auth.uid ||
      resource.data.userId == request.auth.uid ||
      resource.data.ownerId == request.auth.uid ||
      (resource.data.players is list && request.auth.uid in resource.data.players) ||
      (resource.data.participants is list && request.auth.uid in resource.data.participants)
    );

  allow create: if signedIn()
    && request.resource.data.fromUserId == request.auth.uid
    && request.resource.data.toUserId is string
    && request.resource.data.toUserId != request.auth.uid
    && request.resource.data.status == "pending";

  allow update: if signedIn()
    && (
      resource.data.fromUserId == request.auth.uid ||
      resource.data.toUserId == request.auth.uid ||
      resource.data.senderId == request.auth.uid ||
      resource.data.receiverId == request.auth.uid ||
      resource.data.userId == request.auth.uid ||
      resource.data.ownerId == request.auth.uid ||
      (resource.data.players is list && request.auth.uid in resource.data.players) ||
      (resource.data.participants is list && request.auth.uid in resource.data.participants)
    )
    && identityFieldsUnchanged()
    && (
      request.resource.data.status == resource.data.status
      || (
        resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "declined"]
        && resource.data.toUserId == request.auth.uid
      )
      || (
        request.resource.data.status in ["cancelled", "withdrawn"]
        && resource.data.fromUserId == request.auth.uid
      )
    )
    && (request.resource.data.status != "completed" || resource.data.status == "completed");

  allow delete: if false;
}

match /match_invites/{inviteId} {
  allow read: if signedIn();

  allow create: if signedIn()
    && request.resource.data.fromUserId == request.auth.uid
    && request.resource.data.toUserId is string
    && request.resource.data.toUserId != request.auth.uid
    && request.resource.data.inviteStatus == "pending";

  allow update: if signedIn()
    && (
      resource.data.fromUserId == request.auth.uid ||
      resource.data.toUserId == request.auth.uid ||
      resource.data.senderId == request.auth.uid ||
      resource.data.receiverId == request.auth.uid ||
      (
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants
      )
    )
    && identityFieldsUnchanged()
    && (
      request.resource.data.inviteStatus == resource.data.inviteStatus
      || (
        resource.data.inviteStatus == "pending"
        && request.resource.data.inviteStatus in ["accepted", "declined"]
        && resource.data.toUserId == request.auth.uid
      )
      || (
        request.resource.data.inviteStatus in ["cancelled", "withdrawn"]
        && resource.data.fromUserId == request.auth.uid
      )
    )
    && (request.resource.data.inviteStatus != "completed" || resource.data.inviteStatus == "completed");

  allow delete: if false;
}

    match /notifications/{notifId} {
      allow read, update, delete: if isNotificationRecipient();

      allow create: if isNotificationCreateAllowed();
    }

    match /match_scores/{scoreId} {
      allow read: if isMatchPartyFromResource();

      allow create: if isMatchPartyFromRequest();

      allow update: if isMatchPartyFromResource()
        && identityFieldsUnchanged();

      allow delete: if false;
    }

match /match_history/{historyId} {
  allow get, list: if isMatchPartyFromResource();

  // Completed and not-played history is created only by the trusted
  // recordCompletedMatch callable. Admin SDK writes bypass these rules.
  allow create: if false;

  allow update: if signedIn()
    && resource.data.players is list
    && request.auth.uid in resource.data.players
    && identityFieldsUnchanged()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "archivedBy",
      "hiddenFor",
      "summaryAcknowledgedBy",
      "feedbackStatus",
      "updatedAt"
    ]);

  allow delete: if false;
}

    match /completed_matches/{completedId} {
      allow read: if isMatchPartyFromResource();

      allow create: if isMatchPartyFromRequest();

      allow update: if isMatchPartyFromResource()
        && identityFieldsUnchanged();

      allow delete: if false;
    }

    match /match_feedback/{feedbackId} {
      allow read: if isMatchPartyFromResource();

      allow create: if isMatchPartyFromRequest();

      allow update: if isMatchPartyFromResource()
        && identityFieldsUnchanged();

      allow delete: if false;
    }

    match /availabilities/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(uid);
    }

    match /events/{eventId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && validEventDurationOnCreate()
        && (
          request.resource.data.hostId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid
        );

      allow update: if isEventHostFromResource() && validEventDurationOnUpdate();
      allow delete: if isEventHostFromResource();

      match /join_requests/{reqId} {
        allow read: if eventHost(eventId)
          || (signedIn() && resource.data.userId == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update: if eventHost(eventId)
          || (signedIn() && resource.data.userId == request.auth.uid);

        allow delete: if eventHost(eventId);
      }

      match /chat/{messageId} {
        allow read, create: if eventParticipant(eventId);
        allow update, delete: if false;
      }
    }

    match /message_notification_state/{id} {
      allow read, write: if false;
    }

    match /high_probability_match_recommendations/{recommendationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
